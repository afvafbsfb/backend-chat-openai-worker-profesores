# =============================================================================
# CONFIGURACIÓN ELASTIC BEANSTALK PARA SPRING BOOT
# =============================================================================
# Este archivo configura el entorno de AWS para optimizar el despliegue

option_settings:
  # ===== CONFIGURACIÓN DE LA PLATAFORMA =====
  aws:elasticbeanstalk:application:environment:
    # Activar perfil de producción en Spring Boot
    SPRING_PROFILES_ACTIVE: production
    # Puerto que Spring Boot debe usar (EB espera 5000)
    SERVER_PORT: 5000
  
  # ===== CONFIGURACIÓN DEL PROXY NGINX =====
  aws:elasticbeanstalk:environment:proxy:
    # Usar Nginx como proxy reverso
    ProxyServer: nginx
  
  # ===== HEALTH CHECKS =====
  aws:elasticbeanstalk:application:
    # Path del health check (Spring Boot Actuator)
    Application Healthcheck URL: /actuator/health
  
  # ===== CONFIGURACIÓN DEL LOAD BALANCER =====
  aws:elasticbeanstalk:environment:
    # Usar Application Load Balancer (necesario para HTTPS)
    LoadBalancerType: application
  
  aws:elbv2:listener:default:
    # Listener por defecto en puerto 80 (HTTP)
    ListenerEnabled: true
    Protocol: HTTP
  
  # ===== TIMEOUTS =====
  aws:elasticbeanstalk:command:
    # Timeout para deploy (Spring Boot puede tardar en iniciar)
    Timeout: 600
  
  aws:elbv2:loadbalancer:
    # Idle timeout del Load Balancer (importante para conexiones largas)
    IdleTimeout: 60

# =============================================================================
# COMANDOS POST-DEPLOY
# =============================================================================
commands:
  01_make_jar_executable:
    command: "chmod +x /var/app/current/*.jar"
    ignoreErrors: true

# =============================================================================
# ARCHIVOS DE CONFIGURACIÓN NGINX
# =============================================================================
files:
  "/etc/nginx/conf.d/https_redirect.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Redirigir HTTP a HTTPS en producción
      # Esta configuración se activa cuando el Load Balancer termina SSL
      server {
          listen 80;
          
          location / {
              # Verificar si la request viene de HTTPS (desde el Load Balancer)
              if ($http_x_forwarded_proto != 'https') {
                  return 301 https://$host$request_uri;
              }
              
              proxy_pass http://127.0.0.1:5000;
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
          }
      }
