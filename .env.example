# =============================================================================
# VARIABLES DE ENTORNO REQUERIDAS PARA PRODUCCIÓN EN AWS
# =============================================================================
# 
# IMPORTANTE: Este es un archivo de EJEMPLO. NO incluyas valores reales aquí.
# Configura estas variables en AWS Elastic Beanstalk usando:
#   eb setenv VARIABLE=valor
# o desde la consola AWS: Configuration → Software → Environment properties
# =============================================================================

# -----------------------------------------------------------------------------
# SPRING BOOT
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=production

# -----------------------------------------------------------------------------
# OPENAI API (OBLIGATORIO)
# -----------------------------------------------------------------------------
# Tu API key de OpenAI (obtenerla en https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a usar (opcional, por defecto gpt-4-turbo-preview)
OPENAI_MODEL=gpt-4-turbo-preview

# Máximo tokens por respuesta (opcional, por defecto 4000)
OPENAI_MAX_TOKENS=4000

# -----------------------------------------------------------------------------
# API WORKERS (OBLIGATORIO)
# -----------------------------------------------------------------------------
# URL de tu API Workers desplegado en Cloudflare
# Debe ser la URL de producción con HTTPS
API_WORKERS_URL=https://tu-worker-name.workers.dev

# -----------------------------------------------------------------------------
# JWT SECRET (OBLIGATORIO)
# -----------------------------------------------------------------------------
# Secret compartido para validar JWT tokens
# DEBE ser el MISMO que usas en API Workers
# Generar uno seguro con: openssl rand -base64 64
JWT_SECRET_KEY=tu_secret_super_seguro_de_minimo_32_caracteres_compartido_con_api_workers

# -----------------------------------------------------------------------------
# CORS (OBLIGATORIO)
# -----------------------------------------------------------------------------
# Dominios permitidos para CORS (separados por coma si son varios)
# En desarrollo puedes usar http://localhost:XXXX
# En producción usa tu dominio HTTPS
ALLOWED_ORIGINS=https://tu-dominio-android.com,https://tu-dominio-web.com

# -----------------------------------------------------------------------------
# CONFIGURACIÓN OPCIONAL
# -----------------------------------------------------------------------------
# Timeouts para llamadas a API Workers (en milisegundos)
API_WORKERS_CONNECT_TIMEOUT=5000
API_WORKERS_READ_TIMEOUT=30000

# =============================================================================
# INSTRUCCIONES DE CONFIGURACIÓN
# =============================================================================
#
# MÉTODO 1: AWS CLI (recomendado)
# ---------------------------------
# cd backend-chat-openai-worker-profesores
# eb setenv OPENAI_API_KEY=sk-xxx API_WORKERS_URL=https://xxx JWT_SECRET_KEY=xxx ALLOWED_ORIGINS=https://xxx
#
# MÉTODO 2: Consola AWS
# ---------------------
# 1. AWS Console → Elastic Beanstalk
# 2. Seleccionar tu aplicación → Configuration
# 3. Software → Edit
# 4. Environment properties → Add
# 5. Añadir cada variable: Name=OPENAI_API_KEY, Value=sk-xxx
# 6. Apply
#
# MÉTODO 3: Archivo .env local (SOLO DESARROLLO)
# -----------------------------------------------
# 1. Copiar este archivo a .env (sin .example)
# 2. Rellenar valores reales
# 3. Spring Boot cargará las variables automáticamente
# 4. ⚠️ NUNCA subir .env a Git (ya está en .gitignore)
#
# =============================================================================
